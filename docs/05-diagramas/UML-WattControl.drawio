        <mxCell id="MYSJtm0VZS8izvOKb58u-119" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#f3f4f6;strokeColor=#6b7280;fontColor=#1f2937;fontSize=11;spacing=8;" value="&lt;b&gt;&amp;laquo;namespace&amp;raquo; config&lt;/b&gt;&lt;hr&gt;&lt;div align=&quot;left&quot;&gt;• Potencias y límites (MAX_CARGAS)&lt;br&gt;• Tarifas / precios por franja horaria&lt;br&gt;• Umbrales de precio y nivel de embalses&lt;br&gt;• Horas mínimas y semilla aleatoria&lt;/div&gt;" vertex="1">
          <mxGeometry height="135" width="350" x="2358.354799332157" y="778.0967348160282" as="geometry" />
        </mxCell>
        <mxCell id="MYSJtm0VZS8izvOKb58u-120" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#f3f4f6;strokeColor=#6b7280;fontColor=#1f2937;fontSize=11;spacing=8;" value="&lt;b&gt;&amp;laquo;utility / function&amp;raquo; Reporte&lt;/b&gt;&lt;hr&gt;&lt;div align=&quot;left&quot;&gt;+ generarReporteConsumo(&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;energiaTotalKWh: double,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;costoTotalCOP: double): void&lt;br&gt;&lt;i&gt;Definida en src/Reporte.cpp&lt;/i&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="130" width="350" x="2358.354799332157" y="953.0967348160282" as="geometry" />
        </mxCell>
        <mxCell id="MYSJtm0VZS8izvOKb58u-121" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#f3f4f6;strokeColor=#6b7280;fontColor=#1f2937;fontSize=11;spacing=8;" value="&lt;b&gt;&amp;laquo;executable&amp;raquo; main() — wattcontrol.cpp&lt;/b&gt;&lt;hr&gt;&lt;div align=&quot;left&quot;&gt;• Instancia Mercado, Negocio y cargas concretas&lt;br&gt;• Inyecta CargaAplazable / CargaCritica como Carga*&lt;br&gt;• Controla el menú interactivo de consola&lt;br&gt;• Libera memoria dinámica (delete cargas)&lt;/div&gt;" vertex="1">
          <mxGeometry height="155" width="320" x="1238.3547993321572" y="1233.0967348160282" as="geometry" />
        </mxCell>
        <mxCell id="MYSJtm0VZS8izvOKb58u-122" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#eff6ff;strokeColor=#2563eb;fontColor=#1f2937;fontSize=11;spacing=8;" value="&lt;b&gt;Pilares POO aplicados en el repositorio&lt;/b&gt;&lt;hr&gt;&lt;div align=&quot;left&quot;&gt;&lt;b&gt;1. Abstracción:&lt;/b&gt; &lt;i&gt;Carga&lt;/i&gt; define el contrato base sin instanciarse.&lt;br&gt;&lt;b&gt;2. Encapsulamiento:&lt;/b&gt; Atributos privados (&lt;b&gt;-&lt;/b&gt;) y protegidos (&lt;b&gt;#&lt;/b&gt;); getters &lt;b&gt;{query}&lt;/b&gt; (&lt;code&gt;const&lt;/code&gt;).&lt;br&gt;&lt;b&gt;3. Herencia:&lt;/b&gt; &lt;i&gt;CargaAplazable&lt;/i&gt; y &lt;i&gt;CargaCritica&lt;/i&gt; extienden &lt;i&gt;Carga&lt;/i&gt;.&lt;br&gt;&lt;b&gt;4. Polimorfismo:&lt;/b&gt; &lt;i&gt;Negocio&lt;/i&gt; ejecuta &lt;code&gt;cargas_[i]-&amp;gt;debeEncender()&lt;/code&gt; por enlace dinámico (&lt;code&gt;virtual&lt;/code&gt; / &lt;code&gt;override&lt;/code&gt;).&lt;/div&gt;" vertex="1">
          <mxGeometry height="165" width="425" x="1238.3547993321572" y="1413.0967348160282" as="geometry" />
        </mxCell>
        <mxCell id="MYSJtm0VZS8izvOKb58u-123" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fffbeb;strokeColor=#d97706;fontColor=#1f2937;fontSize=11;spacing=8;" value="&lt;b&gt;Leyenda de Relaciones UML 2.x&lt;/b&gt;&lt;hr&gt;&lt;div align=&quot;left&quot;&gt;&lt;b&gt;◆——&lt;/b&gt; &lt;b&gt;Composición:&lt;/b&gt; Negocio posee por valor a Medidor (mismo ciclo de vida) &amp;nbsp;|&amp;nbsp; &lt;b&gt;◇——&amp;gt;&lt;/b&gt; &lt;b&gt;Agregación polimórfica:&lt;/b&gt; Negocio referencia Carga* sin poseer su memoria&lt;br&gt;&lt;b&gt;──▷&lt;/b&gt; &lt;b&gt;Herencia / Generalización:&lt;/b&gt; Subclase extiende a Carga &amp;nbsp;|&amp;nbsp; &lt;b&gt;──&amp;gt;&lt;/b&gt; &lt;b&gt;Asociación:&lt;/b&gt; Navegabilidad hacia Mercado &amp;nbsp;|&amp;nbsp; &lt;b&gt;- - &amp;gt;&lt;/b&gt; &lt;b&gt;Dependencia:&lt;/b&gt; &amp;laquo;use&amp;raquo;, &amp;laquo;call&amp;raquo;, &amp;laquo;instantiate&amp;raquo;&lt;/div&gt;" vertex="1">
          <mxGeometry height="92" width="1470" x="1238.3547993321572" y="1623.0967348160282" as="geometry" />
        </mxCell>
